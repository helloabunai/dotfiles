#!/bin/bash
# Mouse4 for Discord PTT without any app seeing it as "browser back".
#
# Nothing downstream of keyd can suppress one pointer button: Hyprland mouse
# binds fire but don't consume, keyd only remaps keyboard keys, and
# push-to-talk is a passive reader with no grab option. So evsieve grabs the
# keyd virtual pointer and splits it: mouse4 is diverted to a dedicated PTT
# device, and the pointer device apps see has no mouse4 at all. The PTT device
# is disabled in hypr/lua/config.lua so Hyprland won't forward it either;
# push-to-talk reads it straight off evdev and injects the Discord PTT keybind.
# XTEST only fakes buttons 1-10, so nothing above MOUSE10 is possible here.
#
# Usage: pttfix [stop]   -- backgrounded jobs don't get Ctrl+C, so use `pttfix stop`.
set -u

export DISPLAY=${DISPLAY:-:1}
PTT_BUTTON=${PTT_BUTTON:-MOUSE10}
RUNDIR=/run/user/$(id -u)
PTT_LINK="$RUNDIR/pttfix-ptt"
PTR_LINK="$RUNDIR/pttfix-pointer"
PIDFILE="$RUNDIR/pttfix.pid"

# Kill a stale instance and any evsieve still holding the grab, so a SIGKILLed
# run can't leave mouse4 diverted forever.
reap_stale() {
  if [ -f "$PIDFILE" ]; then
    local old
    old=$(cat "$PIDFILE" 2>/dev/null)
    if [ -n "${old:-}" ] && [ "$old" != "$$" ] && kill -0 "$old" 2>/dev/null; then
      kill "$old" 2>/dev/null
      for _ in $(seq 1 20); do kill -0 "$old" 2>/dev/null || break; sleep 0.1; done
      kill -9 "$old" 2>/dev/null
    fi
    rm -f "$PIDFILE"
  fi
  for p in $(pgrep -x evsieve 2>/dev/null); do
    grep -qa "pttfix-ptt" "/proc/$p/cmdline" 2>/dev/null && kill "$p" 2>/dev/null
  done
  sleep 0.3
  for p in $(pgrep -x evsieve 2>/dev/null); do
    grep -qa "pttfix-ptt" "/proc/$p/cmdline" 2>/dev/null && kill -9 "$p" 2>/dev/null
  done
  rm -f "$PTT_LINK" "$PTR_LINK"
}

if [ "${1:-}" = "stop" ]; then
  reap_stale
  echo "pttfix: stopped"
  exit 0
fi

reap_stale

SRC=$(grep -l "keyd virtual pointer" /sys/class/input/event*/device/name | awk -F'/' '{print "/dev/input/"$5}')
if [ -z "$SRC" ]; then
  echo "pttfix: no 'keyd virtual pointer' device found" >&2
  exit 1
fi

EVSIEVE_PID=""
PTT_PID=""
cleanup() {
  [ -n "$PTT_PID" ] && kill "$PTT_PID" 2>/dev/null
  if [ -n "$EVSIEVE_PID" ]; then
    kill "$EVSIEVE_PID" 2>/dev/null
    for _ in $(seq 1 20); do kill -0 "$EVSIEVE_PID" 2>/dev/null || break; sleep 0.1; done
    kill -9 "$EVSIEVE_PID" 2>/dev/null
  fi
  rm -f "$PTT_LINK" "$PTR_LINK" "$PIDFILE"
}
trap cleanup EXIT INT TERM HUP QUIT

echo $$ > "$PIDFILE"

evsieve --input "$SRC" grab domain=mouse \
        --map btn:side@mouse btn:task@ptt \
        --output @ptt create-link="$PTT_LINK" name="pttfix ptt" \
        --output @mouse create-link="$PTR_LINK" name="pttfix pointer" &
EVSIEVE_PID=$!

for _ in $(seq 1 30); do
  [ -e "$PTT_LINK" ] && [ -e "$PTR_LINK" ] && break
  sleep 0.1
done
if [ ! -e "$PTT_LINK" ]; then
  echo "pttfix: evsieve did not create $PTT_LINK" >&2
  exit 1
fi

/usr/bin/push-to-talk "$PTT_LINK" -k BTN_TASK -n "$PTT_BUTTON" &
PTT_PID=$!
wait "$PTT_PID"
